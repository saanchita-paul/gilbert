{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-intl": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php-laravel": "^3.6",
        "barryvdh/laravel-snappy": "^1.0",
        "cmixin/business-time": "^1.11",
        "doctrine/dbal": "^3.1",
        "fideloper/proxy": "^4.2",
        "firebase/php-jwt": "^5.5",
        "fruitcake/laravel-cors": "^2.0",
        "gmostafa/php-graphql-client": "^1.13",
        "googleads/google-ads-php": "18.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "h4cc/wkhtmltoimage-amd64": "0.12.x",
        "h4cc/wkhtmltopdf-amd64": "0.12.x",
        "jaybizzle/crawler-detect": "^1.2",
        "laravel-notification-channels/twilio": "^3.2",
        "laravel/framework": "^v8.83.0",
        "laravel/horizon": "^5.10",
        "laravel/sanctum": "^2.6",
        "laravel/telescope": "^4.2.0",
        "laravel/tinker": "^2.0",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^1.1",
        "pusher/pusher-php-server": "~4.0",
        "rap2hpoutre/fast-excel": "^3.1",
        "spatie/laravel-permission": "^4.2",
        "twilio/sdk": "^6.41"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.10",
        "facade/ignition": "^2.3.6",
        "fakerphp/faker": "^1.13.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Foxie\\": "app/Modules/Foxie",
            "Ignite\\": "app/Modules/Ignite",
            "FastConnect\\": "app/Modules/FastConnect",
            "OurProperty\\": "app/Modules/OurProperty",
            "ExternalLead\\": "app/Modules/ExternalLead",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "PropertyMe\\": "app/Modules/PropertyMe",
            "HoodLead\\": "app/Modules/HoodLead",
            "TSA\\": "app/Modules/TSA",
            "Reporting\\": "app/Modules/Reporting",
            "Origin\\": "app/Modules/Origin",
            "Powershop\\": "app/Modules/Powershop",
            "MRI\\": "app/Modules/MRI"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
